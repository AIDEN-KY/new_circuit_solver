# SQLite 题库位置。相对路径以 backend 目录为基准。
CIRCUIT_DATABASE_PATH=data/circuit_solver.db

# AI Provider：ollama、deepseek 或 openai_compatible。
AI_PROVIDER=ollama

# Provider 使用的模型名称。
AI_MODEL=qwen3-vl:4b-instruct

# 本地 Ollama 服务。不要在末尾添加斜杠。
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 云端视觉接口配置。DeepSeek 使用 https://api.deepseek.com。
# 不要把真实密钥写入 .env.example 或提交到 Git，只填写本机 backend/.env。
AI_API_BASE_URL=
AI_API_KEY=

# 相似度达到该值时直接返回题库答案。
LIBRARY_MATCH_THRESHOLD=0.92

# AI 请求超时秒数。本地模型首次加载通常较慢。
AI_TIMEOUT_SECONDS=480

# 限制模型过度展开，避免单题无限生成。
AI_MAX_OUTPUT_TOKENS=8192

# DeepSeek Responses API 推理强度：none、low、high、max。
AI_REASONING_EFFORT=none

# 解码后的图片体积上限。
MAX_IMAGE_BYTES=8388608

# 用户端默认必须登录。新用户赠送3次，之后每次消耗10分（0.1元）。
AUTH_REQUIRED=true
INITIAL_FREE_USES=3
SOLVE_PRICE_FEN=10
SESSION_DAYS=30

# Admin 管理后台。留空则关闭后台接口；真实密码只写本机 backend/.env，不要提交到 Git。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请修改为长度至少12位的随机密码

# 公网进程由 app.public_main 强制关闭 Admin；下列值仅供单进程调试。
ADMIN_ROUTES_ENABLED=true
TRUST_CLOUDFLARE_HEADERS=false
MAX_REQUEST_BYTES=10485760
MAX_CONCURRENT_SOLVES=2
